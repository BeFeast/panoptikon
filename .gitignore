# Smoke test screenshots — generated by scripts/smoke-test.sh on each deploy.
# These are NOT visual regression baselines; tracking them causes the working
# tree to appear dirty after a deploy, which blocks subsequent git checkout/pull.
web/tests/screenshots/smoke-*.png
web/tests/screenshots/.last-run.json

# Agent config (contains API keys)
agent/config.toml

# tmux logs
tmux-*.log

# agent-orchestrator config
agent-orchestrator.yaml
